# Application
NODE_ENV=development
PORT=4100

# Database: internal PostgreSQL for development. `npm run start:dev` (watch)
# and `npm run start:local` (built API) start it automatically; data is kept
# in backend/data/pg (delete that folder to start empty).
# `npm run start:prod` does NOT start it: production uses the server database.
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kenya_sme
DB_SYNCHRONIZE=true

# Optional: a full connection string overrides the DB_* values above
DATABASE_URL=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Assistant (Gemini) — optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_SYSTEM_API_BASE=http://127.0.0.1:4100
AI_BUSINESS_ID=

# M-Pesa STK push (Safaricom Daraja), optional: the checkout "Prompt to pay" needs these
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Buy Goods till number (leave empty to use the paybill shortcode)
MPESA_TILL=
# Public HTTPS address of POST /api/v1/payments/mpesa/callback
MPESA_CALLBACK_URL=

# Outbound SMS (BulkSMS gateway), optional: the "Message client" buttons need these.
# Sending stays disabled until API URL, key and sender ID are all present.
# The host differs between BulkSMS deployments, so set it to your own gateway.
BULKSMS_API_URL=
BULKSMS_API_KEY=
# Sender ID / shortcode registered with your provider (e.g. KNOXVILLE)
BULKSMS_SENDER_ID=
# Header the gateway reads the key from
BULKSMS_AUTH_HEADER=h_api_key

# Admin login created on first start (email defaults to admin@knoxvilletechnologies.com).
# ADMIN_PASSWORD is required (8+ characters) and is only used to create the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
