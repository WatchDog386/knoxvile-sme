# Frontend Environment Variables
# Copy this file to .env and fill in your values

# API base URL. Leave empty for local dev — requests go to /api/v1, which Vite
# (npm run dev) forwards to the backend.
VITE_API_BASE_URL=

# M-Pesa paybill shown to clients on banners and payment reminders
VITE_MPESA_PAYBILL=
