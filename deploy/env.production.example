# Backend environment for the production host.
# Lives at /opt/business-sme/backend/.env on the server. Never commit the real file.

NODE_ENV=production
PORT=4100

# --- PostgreSQL on this server ------------------------------------------
# The database runs on the VM itself (database kenya_sme), so no SSL.
DATABASE_URL=
DB_DRIVER=postgres
DB_SSL=false
DB_SYNCHRONIZE=true
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=kenya_sme

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# --- Frontend / CORS -----------------------------------------------------
# Must be the public https origin users visit.
FRONTEND_URL=https://sme.knoxvilletechnologies.com
CORS_ORIGIN=https://sme.knoxvilletechnologies.com

# --- Admin login -------------------------------------------------------
# Created on first start only (ADMIN_PASSWORD required, 8+ characters);
# change the password in the app afterwards.
ADMIN_EMAIL=admin@knoxvilletechnologies.com
ADMIN_PASSWORD=

# --- AI assistant (optional) --------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_SYSTEM_API_BASE=http://127.0.0.1:4100
AI_BUSINESS_ID=

# --- M-Pesa STK (optional) ----------------------------------------------
# Prompts through the paybill owner's system: we post {account, phone, amount}
# here and the payment comes back through the paybill webhook below. When set,
# the Daraja keys underneath are not used for prompts.
MPESA_PROMPT_URL=
# Optional: sent as X-Webhook-Secret if their prompt URL asks for one
MPESA_PROMPT_SECRET=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL=
# Must be a public HTTPS URL reachable from Safaricom.
MPESA_CALLBACK_URL=https://YOUR-DOMAIN/api/v1/payments/mpesa/callback

# --- Outbound SMS (optional) --------------------------------------------
BULKSMS_API_URL=
BULKSMS_API_KEY=
BULKSMS_SENDER_ID=
BULKSMS_AUTH_HEADER=h_api_key
# --- M-Pesa paybill webhook ----------------------------------------------
# The company's existing M-Pesa integration forwards each paybill payment to
# POST https://sme.knoxvilletechnologies.com/api/v1/payments/mpesa/c2b with this
# secret in the X-Webhook-Secret header. Generate with: openssl rand -hex 32
MPESA_WEBHOOK_SECRET=
# Optional: which business receives the payments (defaults to the first one)
MPESA_C2B_BUSINESS_ID=

# --- SMS (Mobile Sasa) -------------------------------------------------------
# API token from account.mobilesasa.com -> Settings -> API Tokens (scope: Send messages)
SMS_PROVIDER=mobilesasa
BULKSMS_API_URL=https://api.mobilesasa.com/v1/send/message
BULKSMS_API_KEY=
# Your registered sender ID; leave blank to use the shared MOBILESASA sender
BULKSMS_SENDER_ID=
# Mobile Sasa → Settings → Webhooks → signing secret (whsec_...). Point the
# callback URL at https://sme.knoxvilletechnologies.com/api/v1/sms/mobilesasa/callback
MOBILESASA_WEBHOOK_SECRET=

# --- Email (SMTP) for invoices, receipts and payment reminders -----------------
# Easiest: run  sudo bash deploy/configure-messaging.sh  (password typed hidden)
SMTP_HOST=mail.knoxville.co.ke
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM='Knoxville Technologies <billing@knoxville.co.ke>'

# --- WhatsApp (Meta WhatsApp Cloud API) ----------------------------------------
# Permanent system-user token and phone number ID from Meta (WhatsApp Manager).
# Business-started chats need an approved template; its body variables are
# {{1}} first name, {{2}} amount due, {{3}} account number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=payment_reminder
WHATSAPP_TEMPLATE_LANG=en
