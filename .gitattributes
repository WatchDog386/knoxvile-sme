# Deploy artifacts are consumed by Linux tooling - never let git convert
# them to CRLF. A CRLF in a shebang or systemd unit makes the host fail.
* text=auto
deploy/** text eol=lf
*.sh    text eol=lf
*.service text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf

# Windows-only
*.ps1   text eol=crlf